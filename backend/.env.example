# Copy to .env and fill in your values

# Required: Anthropic API key for Claude Vision milestone detection
ANTHROPIC_API_KEY=sk-ant-...

# CORS — comma-separated allowed origins (default * = allow all, fine for local dev)
# For iPhone on local network: ALLOWED_ORIGINS=*
# For production lock-down: ALLOWED_ORIGINS=https://yourdomain.com
# ALLOWED_ORIGINS=*

# Optional: override default SQLite path
# DATABASE_URL=sqlite+aiosqlite:///./baby_book.db

# Optional: override thumbnail / upload storage dirs
# THUMBNAILS_DIR=./thumbnails
# UPLOADS_DIR=./uploads
